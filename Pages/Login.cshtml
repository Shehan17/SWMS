@page
@model SWMS.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}
<div class="parent">

    <div class="auth-container d-flex justify-content-center align-items-center login-container">

        <!-- Register Form (default visible) -->
        <div id="register-form">
            <h2>Register</h2>
            <form>
                <input type="text" placeholder="Username" class="form-control mb-2">
                <input type="email" placeholder="Email" class="form-control mb-2">
                <input type="password" placeholder="Password" class="form-control mb-2">
                <button type="submit" class="btn btn-success w-100">Register</button>
            </form>
            <p class="mt-2">Already have an account? <a href="#" id="show-login">Login</a></p>
        </div>

        <!-- Login Form (hidden by default) -->
        <div id="login-form" style="display: none;">
            <h2>Login</h2>
            <form>
                <input type="email" placeholder="Email" class="form-control mb-2">
                <input type="password" placeholder="Password" class="form-control mb-2">
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
            <p class="mt-2">Don't have an account? <a href="#" id="show-register">Register</a></p>
        </div>

    </div>

    <script>
        const loginForm = document.getElementById('login-form');
        const registerForm = document.getElementById('register-form');

        document.getElementById('show-login').addEventListener('click', (e) => {
          e.preventDefault();
          registerForm.style.display = 'none';
          loginForm.style.display = 'block';
        });

        document.getElementById('show-register').addEventListener('click', (e) => {
          e.preventDefault();
          loginForm.style.display = 'none';
          registerForm.style.display = 'block';
        });
    </script>

</div>